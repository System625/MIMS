strict-peer-dependencies=false
auto-install-peers=true

# Tuned for a slow/unreliable link. The large binary tarballs (Next's SWC
# binary is ~42MB) time out at pnpm's defaults, and too many parallel streams
# starve each other into timing out rather than finishing.
fetch-timeout=1800000
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=3
