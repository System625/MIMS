# Root-level variables shared by the whole workspace.
# Each app also has its own .env.example — copy all three:
#
#   cp .env.example .env
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
#   cp apps/admin/.env.example apps/admin/.env

# Used by Drizzle Kit (generate / migrate / studio / seed) from the repo root.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mims
