{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@mims/web...",
    "watchPatterns": [
      "apps/web/**",
      "packages/contracts/**",
      "package.json",
      "pnpm-lock.yaml",
      "turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @mims/web start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
