# Base URL of the MIMS API, without a trailing slash.
# Local: the API's dev port. Production: the Railway public domain for the api service.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Public base URL of the Cloudflare R2 bucket holding listing photographs, on a
# Cloudflare zone with Image Transformations enabled — e.g. https://img.mims.ng
# No trailing slash. Delivery goes through /cdn-cgi/image/... on this host; see
# src/lib/images.ts.
#
# LEAVE IT UNSET AND EVERY LISTING FALLS BACK TO ITS DRAWN STATE, which is the
# correct behaviour today: we hold no listing photography yet, and a
# half-configured deployment must never put a broken image in front of a
# customer.
NEXT_PUBLIC_IMAGE_BASE_URL=
