# ---- runtime ----
NODE_ENV=development
# Railway injects PORT in production; this is the local default.
PORT=3333

# ---- database ----
# Railway Postgres connection string. Use the internal URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mims
DATABASE_MAX_CONNECTIONS=10
# Set to "true" to echo every SQL statement. Development only.
DATABASE_LOG_QUERIES=false

# ---- cors ----
# Comma-separated browser origins allowed to call this API: web, then admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- auth (configured, not yet wired up) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# ---- NHTSA vPIC (free, no API key) ----
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
VPIC_TIMEOUT_MS=6000
