# ---- runtime ----
NODE_ENV=development
# Railway injects PORT in production; this is the local default.
PORT=3333

# ---- database ----
# Railway Postgres connection string. Use the internal URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mims
DATABASE_MAX_CONNECTIONS=10
# Set to "true" to echo every SQL statement. Development only.
DATABASE_LOG_QUERIES=false

# ---- cors ----
# Comma-separated browser origins allowed to call this API: web, then admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- auth (configured, not yet wired up) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# ---- NHTSA vPIC (free, no API key) ----
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
VPIC_TIMEOUT_MS=6000

# Paystack. Test keys are fine for everything except taking real money.
# The SECRET key is also the webhook signing key — there is no separate secret.
# Leave unset and every payment route refuses rather than half-working.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=12000
# Where a receipt goes for a guest who gave no email address.
PAYSTACK_FALLBACK_EMAIL_DOMAIN=receipts.mims.ng
